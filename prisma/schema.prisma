datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Roles as plain strings (not a native enum) so this schema can move to
// Postgres later with no type changes: "ADMIN" | "GESTOR" | "VIGILANTE" | "TECNICO_MANUTENCAO"
model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  role         String   @default("VIGILANTE")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  scans       Scan[]
  auditLogs   AuditLog[]
  rounds      Round[]
  occurrences Occurrence[]

  maintenanceTasksAssigned MaintenanceTask[]      @relation("MaintenanceAssignee")
  maintenanceExecutions    MaintenanceExecution[]
  maintenanceReviews       MaintenanceExecution[] @relation("MaintenanceReviewer")

  @@index([role])
}

model Plant {
  id            String   @id @default(uuid())
  name          String
  code          String   @unique
  ownerCompany  String
  cnpj          String?
  state         String
  city          String
  latitude      Float
  longitude     Float
  areaHectares  Float?
  status        String   @default("ATIVA")
  operationDate DateTime?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  equipment Equipment[]
  scans     Scan[]
  routes      InspectionRoute[]
  rounds      Round[]
  occurrences Occurrence[]
  alerts      Alert[]
  maintenanceTasks MaintenanceTask[]

  @@index([code])
}

model Equipment {
  id          String   @id @default(uuid())
  plantId     String
  code        String
  name        String
  type        String
  latitude    Float
  longitude   Float
  description String?
  status      String   @default("ATIVO")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  plant   Plant    @relation(fields: [plantId], references: [id])
  qrCode  QrCode?
  scans   Scan[]
  routePoints RoutePoint[]
  occurrences Occurrence[]
  maintenanceTasks MaintenanceTask[]

  @@unique([plantId, code])
  @@index([plantId])
}

model QrCode {
  id           String    @id @default(uuid())
  equipmentId  String    @unique
  token        String    @unique
  status       String    @default("ACTIVE")
  createdAt    DateTime  @default(now())
  invalidatedAt DateTime?

  equipment Equipment @relation(fields: [equipmentId], references: [id])

  @@index([token])
}

// A scan is a QR read event captured by a vigilante in the field. It is
// created immutably from the mobile app; back-office roles (Admin/Gestor)
// may subsequently correct or remove a record, and every such change is
// written to AuditLog so the original capture is never silently lost.
model Scan {
  id                     String   @id @default(uuid())
  userId                 String
  plantId                String
  equipmentId            String
  roundId                String?
  qrToken                String
  scannedAt              DateTime @default(now())
  latitude               Float
  longitude              Float
  accuracyMeters         Float?
  deviceInfo             String?
  distanceFromEquipmentM Float?
  distanceFlag           String?  // "ok" | "attention" | "inconsistent"
  notes                  String?
  photoUrl               String?  // deprecated: first photo, kept for old records — see photoUrls
  photoUrls              String[] @default([])
  status                 String   @default("OK") // "OK" | "ANOMALIA"
  offlineCreatedAt       DateTime?
  syncedAt               DateTime?
  createdAt              DateTime @default(now())

  user      User       @relation(fields: [userId], references: [id])
  plant     Plant      @relation(fields: [plantId], references: [id])
  equipment Equipment  @relation(fields: [equipmentId], references: [id])
  round     Round?     @relation(fields: [roundId], references: [id])
  occurrences Occurrence[]

  @@index([plantId, scannedAt])
  @@index([userId, scannedAt])
  @@index([equipmentId])
  @@index([roundId])
}

// A named, ordered sequence of inspection points a route can be planned from.
model InspectionRoute {
  id                String   @id @default(uuid())
  plantId           String
  name              String
  shift             String? // "DIA" | "NOITE" | free text
  daysOfWeek        String  @default("1,2,3,4,5,6,0") // comma-separated 0=Sun..6=Sat
  toleranceMinutes  Int     @default(30)
  active            Boolean @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  plant  Plant        @relation(fields: [plantId], references: [id])
  points RoutePoint[]
  rounds Round[]

  @@index([plantId])
}

model RoutePoint {
  id          String @id @default(uuid())
  routeId     String
  equipmentId String
  order       Int
  expectedTimeOfDay String? // "HH:MM", optional

  route     InspectionRoute @relation(fields: [routeId], references: [id])
  equipment Equipment       @relation(fields: [equipmentId], references: [id])

  @@unique([routeId, equipmentId])
  @@index([routeId])
}

// A round is one vigilante's walk through the plant, from start to finish.
// Its planned/visited point counts are computed when it ends.
model Round {
  id                String    @id @default(uuid())
  userId            String
  plantId           String
  routeId           String?
  startedAt         DateTime  @default(now())
  endedAt           DateTime?
  status            String    @default("IN_PROGRESS") // "IN_PROGRESS" | "COMPLETED"
  plannedPoints     Int       @default(0)
  visitedPoints     Int       @default(0)
  completionPercent Float?
  distanceMeters    Float?
  createdAt         DateTime  @default(now())

  user  User             @relation(fields: [userId], references: [id])
  plant Plant            @relation(fields: [plantId], references: [id])
  route InspectionRoute? @relation(fields: [routeId], references: [id])
  scans Scan[]
  alerts Alert[]

  @@index([plantId, startedAt])
  @@index([userId, startedAt])
}

// Something the vigilante found in the field: a damaged fence, an open
// gate, an intruder, etc. Optionally tied to the scan that triggered it.
model Occurrence {
  id          String   @id @default(uuid())
  scanId      String?
  equipmentId String?
  plantId     String
  userId      String
  category    String
  severity    String   @default("MEDIA") // "BAIXA" | "MEDIA" | "ALTA" | "CRITICA"
  description String?
  photoUrl    String? // deprecated: first photo, kept for old records — see photoUrls
  photoUrls   String[] @default([])
  status      String   @default("ABERTA") // "ABERTA" | "EM_ANALISE" | "EM_ANDAMENTO" | "RESOLVIDA" | "CANCELADA"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  resolvedAt  DateTime?

  scan      Scan?      @relation(fields: [scanId], references: [id])
  equipment Equipment? @relation(fields: [equipmentId], references: [id])
  plant     Plant      @relation(fields: [plantId], references: [id])
  user      User       @relation(fields: [userId], references: [id])

  @@index([plantId, status])
  @@index([equipmentId])
}

// Operational alerts raised automatically from rounds/scans, for the
// dashboard and (later) email/WhatsApp notification channels.
model Alert {
  id        String   @id @default(uuid())
  plantId   String
  roundId   String?
  type      String  // "RONDA_INCOMPLETA" | "LEITURA_INCONSISTENTE" | "LEITURA_FORA_DE_HORARIO" | "QRCODE_NAO_VISITADO"
  severity  String  @default("MEDIA")
  message   String
  status    String  @default("ABERTO") // "ABERTO" | "RESOLVIDO"
  createdAt DateTime @default(now())
  resolvedAt DateTime?

  plant Plant  @relation(fields: [plantId], references: [id])
  round Round? @relation(fields: [roundId], references: [id])

  @@index([plantId, status])
  @@index([createdAt])
}

// Append-only audit trail for administrative changes.
model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  before    String?
  after     String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([createdAt])
}

// A recurring maintenance activity definition (the "plano de manutenção"):
// what has to be done, how often, and by which role/technician. Concrete due
// instances are materialized on demand as MaintenanceExecution rows — see
// src/lib/maintenanceSchedule.ts for how a period is computed from frequency.
model MaintenanceTask {
  id                  String   @id @default(uuid())
  plantId             String
  equipmentId         String?
  title               String
  description         String?
  category            String?
  frequency           String   // "DIARIA" | "SEMANAL" | "MENSAL" | "TRIMESTRAL" | "SEMESTRAL" | "ANUAL"
  scheduledMonths     Int[]    @default([]) // 1-12; only used by TRIMESTRAL/SEMESTRAL/ANUAL — empty means "every period"
  requiredTechnicians Int      @default(1)
  assignedRole        String?
  assignedUserId      String?
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  plant        Plant                  @relation(fields: [plantId], references: [id])
  equipment    Equipment?             @relation(fields: [equipmentId], references: [id])
  assignedUser User?                  @relation("MaintenanceAssignee", fields: [assignedUserId], references: [id])
  executions   MaintenanceExecution[]

  @@index([plantId])
  @@index([frequency])
  @@index([assignedUserId])
}

// One concrete due instance of a MaintenanceTask for a given period (day,
// ISO week, month, quarter, semester or year). Materialized lazily by
// /api/maintenance/today the first time a period becomes current, so no
// history is pre-generated for periods no one has reached yet.
model MaintenanceExecution {
  id                     String    @id @default(uuid())
  taskId                 String
  periodKey              String
  dueDate                DateTime
  status                 String    @default("PENDENTE") // "PENDENTE" | "EM_ANDAMENTO" | "CONCLUIDA" | "ATRASADA" | "CANCELADA"
  userId                 String?
  startedAt              DateTime?
  completedAt            DateTime?
  latitude               Float?
  longitude              Float?
  distanceFromEquipmentM Float?
  distanceFlag           String?
  notes                  String?
  photoUrls              String[]  @default([])
  reviewStatus           String?   // "APROVADO" | "REPROVADO" | "CORRIGIR" — set by a Gestor/Admin reviewing a CONCLUIDA execution
  reviewNotes            String?
  reviewedBy             String?
  reviewedAt             DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  task     MaintenanceTask @relation(fields: [taskId], references: [id])
  user     User?           @relation(fields: [userId], references: [id])
  reviewer User?           @relation("MaintenanceReviewer", fields: [reviewedBy], references: [id])

  @@unique([taskId, periodKey])
  @@index([status])
  @@index([dueDate])
  @@index([userId])
}
